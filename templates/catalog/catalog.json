{% set releases = load_data(path="data/releases.json") %}
{
  "software": [
{%- set_global count = 0 %}
{% set software_section = get_section(path="portfolio/software/_index.md") %}
{%- for page in software_section.pages %}
{%- if page.extra.hub is defined and page.extra.hub.exposed %}
{%- if count > 0 %},{% endif %}
{%- set_global count = count + 1 %}
    {
      "name": {{ page.extra.project_title | default(value=page.title) | json_encode() | safe }},
      "description": {{ page.description | default(value="") | json_encode() | safe }},
      "url": {{ page.permalink | json_encode() | safe }},
      "icon": {
        "url": {{ page.extra.logo | default(value="") | replace(from=".avif", to=".webp") | json_encode() | safe }},
        "width": {{ page.extra.logo_width | default(value=512) }},
        "height": {{ page.extra.logo_height | default(value=512) }}
      },
      "screenshots": [{% for shot in page.extra.screenshot_urls | default(value=[]) %}{{ shot | replace(from=".avif", to=".webp") | json_encode() | safe }}{% if not loop.last %}, {% endif %}{% endfor %}],
      "releases": [{% set entries = releases[page.slug].releases | default(value=[]) %}{% for r in entries %}
        {
          "version": {{ r.version | json_encode() | safe }},
          "date": {{ r.date | default(value="") | json_encode() | safe }},
          "highlights": [{% for h in r.highlights | default(value=[]) %}{{ h | json_encode() | safe }}{% if not loop.last %}, {% endif %}{% endfor %}]
        }{% if not loop.last %},{% endif %}{% endfor %}
      ]
    }
{%- endif %}
{%- endfor %}
  ]
}
